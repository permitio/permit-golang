# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[{*.go,go.mod}]
indent_style = tab

[*.md]
max_line_length = off

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

# API spec snapshots, test fixtures and the release binary lock have lines that cannot be wrapped.
[{testdata/**,**/testdata/**,tools/specs/**,tools/binaries.lock}]
max_line_length = off
