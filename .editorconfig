# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[{*.go,go.mod}]
indent_style = tab

[*.md]
max_line_length = off

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

# API spec snapshots, test fixtures, the release binary lock and the list of required tests have
# lines that cannot be wrapped.
[{testdata/**,**/testdata/**,tools/specs/**,tools/binaries.lock,.github/required-tests.txt}]
max_line_length = off

# An entry of a list of allowed skips is one line, which cannot be wrapped.
[{.github/allowed-skips.txt,tools/e2e/allowed-skips.txt}]
max_line_length = off

# The v1 surface that apisurface writes has routes that cannot be wrapped.
[tools/migration/v1-surface.txt]
max_line_length = off
