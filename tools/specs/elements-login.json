          "element_bearer_token": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "error_code": {
            "type": "integer"
          },
          "extra": {
            "type": "string"
          },
          "redirect_url": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "redirect_url"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "UserLoginRequestInput": {
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "tenant_id"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "paths": {
    "/v2/auth/elements_login_as": {
      "post": {
        "operationId": "elements_login_as",
        "parameters": [
          {
            "in": "cookie",
            "name": "permit_session",
            "required": false,
            "schema": {
